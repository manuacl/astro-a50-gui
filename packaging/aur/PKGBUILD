# Maintainer: manuacl <manu dot acl at gmail dot com>

pkgname=astro-a50-gui
pkgver=0.6.3
pkgrel=1
pkgdesc="Qt GUI to configure the Astro A50 Gen 4 wireless headset (EQ, balance, mic, noise gate)"
arch=('any')
url="https://github.com/manuacl/astro-a50-gui"
license=('GPL-3.0-or-later' 'MIT' 'ISC')
depends=('python' 'python-pyqt6' 'python-pyusb' 'qt6-svg')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9d9d3721f698e49b91016a90a5df7939bcd4def7309f8c38b57ec409cd671cb8')

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen python -m unittest tests.py
}

package() {
  cd "$pkgname-$pkgver"
  local app="/usr/share/$pkgname"

  install -Dm644 -t "$pkgdir$app" $(ls *.py | grep -vx tests.py)
  install -Dm644 -t "$pkgdir$app/vendor" vendor/*.py
  install -Dm644 -t "$pkgdir$app/themes" themes/*.json
  install -Dm644 -t "$pkgdir$app/icons" icons/*.svg
  # gui.py reads its version from it, for the About dialog.
  install -Dm644 -t "$pkgdir$app" pyproject.toml
  python -m compileall -q -d "$app" "$pkgdir$app"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<EOF
#!/bin/sh
exec python $app/gui.py "\$@"
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Astro A50 Config
GenericName=Headset configuration
Comment=Configure the Astro A50 headset (EQ, balance, mic, noise gate)
Exec=$pkgname
Icon=audio-headset
Terminal=false
Categories=AudioVideo;Audio;Settings;
Keywords=astro;a50;headset;audio;
StartupWMClass=$pkgname
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/50-astro-a50.rules" <<EOF
SUBSYSTEM=="usb", ATTR{idVendor}=="9886", ATTR{idProduct}=="002c", TAG+="uaccess"
EOF

  install -Dm644 vendor/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/eh-fifty-LICENSE.txt"
  install -Dm644 icons/LICENSE-lucide.txt "$pkgdir/usr/share/licenses/$pkgname/lucide-LICENSE.txt"
}
